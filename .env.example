# Copie a .env.local (desarrollo) y reemplace TODOS los valores. Nunca suba .env.local al repositorio.
# Generar claves: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Usuario de la app: solo SELECT/INSERT/UPDATE/DELETE
DATABASE_URL=mysql://ventas_app:CAMBIAR@localhost:3306/ventas_segura
# Aiven / RDS: ruta al certificado de la CA descargado de la consola (ej. ./certs/aiven-ca.pem). Vacío = sin TLS (solo local).
DATABASE_CA_CERT=
# Usuario de migraciones (DDL) — solo para npm run db:migrate
MIGRATOR_DATABASE_URL=mysql://ventas_migrator:CAMBIAR@localhost:3306/ventas_segura

APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=CAMBIAR_min_32_caracteres_aleatorios
FIELD_ENCRYPTION_KEY=CAMBIAR_base64_32_bytes
HMAC_KEY=CAMBIAR_base64_32_bytes

# Correo (vacío en desarrollo = los enlaces se imprimen en la consola del servidor)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ventas Online <no-reply@example.com>"

# Pagos: simulado (laboratorio) | paypal (sandbox/producción)
PAYMENT_MODE=simulado
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

UPLOAD_DIR=./uploads
LOG_LEVEL=info
# true solo si la app está detrás de un proxy de confianza (WAF/ALB) que fija X-Real-IP / X-Forwarded-For
TRUST_PROXY=false

# Solo para scripts/migrar-legado.ts (usuario de SOLO LECTURA sobre la BD legada)
LEGACY_DATABASE_URL=mysql://legado_lectura:CAMBIAR@localhost:3306/fornitureinvestment
LEGACY_IMAGES_DIR="C:/xampp/htdocs/Desarrollo Web/Sistemas de ventas en linea/images/productos"

# Contraseñas filtradas (HIBP). Poner false solo sin acceso a internet (CI)
PASSWORD_BREACH_CHECK=true
# SOLO laboratorio/E2E: guarda los correos como archivos JSON. Incompatible con SMTP_HOST.
# MAIL_CAPTURE_DIR=./reportes/correos
