# Copiar a .env.docker y reemplazar TODOS los valores. Nunca versionar .env.docker.
# Generar claves: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- MySQL (contenedor db) ---
MYSQL_ROOT_PASSWORD=CAMBIAR_root_largo_y_aleatorio
MYSQL_DATABASE=ventas_segura
APP_DB_PASSWORD=CAMBIAR_password_ventas_app
MIGRATOR_DB_PASSWORD=CAMBIAR_password_ventas_migrator

# --- Aplicación ---
DATABASE_URL=mysql://ventas_app:CAMBIAR_password_ventas_app@db:3306/ventas_segura
MIGRATOR_DATABASE_URL=mysql://ventas_migrator:CAMBIAR_password_ventas_migrator@db:3306/ventas_segura
APP_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=CAMBIAR_min_32_caracteres_aleatorios
FIELD_ENCRYPTION_KEY=CAMBIAR_base64_32_bytes
HMAC_KEY=CAMBIAR_base64_32_bytes
LOG_LEVEL=info
TRUST_PROXY=true
UPLOAD_DIR=/data/uploads

# --- Correo ---
# Laboratorio: deje SMTP_HOST vacío y use el buzón de archivos (./reportes/correos en el host).
# Producción: defina SMTP_* y elimine MAIL_CAPTURE_DIR (la app rechaza ambos a la vez).
MAIL_CAPTURE_DIR=/data/correos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR
SMTP_FROM="Ventas Online <no-reply@example.com>"

# --- Pagos ---
PAYMENT_MODE=simulado
# Solo laboratorio/DAST: con NODE_ENV=production la app rechaza el pago simulado salvo que esto sea true.
ALLOW_SIMULATED_PAYMENTS=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
