# Endurecimiento de npm (cadena de suministro) — skill dependency-upgrade.
# No ejecutar scripts de instalación (preinstall/postinstall) de dependencias: vector típico de malware.
ignore-scripts=true
# Fallar si la versión de Node no cumple "engines" de package.json.
engine-strict=true
# npm audit falla desde severidad alta.
audit-level=high
fund=false
# Nota: npm 11.7 no soporta "min-release-age" ni "allow-git"; el periodo de espera (cooldown)
# de 7 días para versiones nuevas se aplica en Dependabot (.github/dependabot.yml).
