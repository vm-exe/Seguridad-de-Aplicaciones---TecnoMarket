# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.docker.example

# archivos subidos y reportes locales de seguridad
/uploads/
/reportes/
/certs/

# Terraform: estado local, configuración de backend y variables con datos de la cuenta
**/.terraform/
*.tfstate
*.tfstate.*
infra/terraform/aws/backend.hcl
infra/terraform/aws/terraform.tfvars

# Playwright
/playwright-report/
/test-results/
/e2e/.auth/

# Instrucciones locales para asistentes de IA (viven fuera del repositorio)
/AGENTS.md
/CLAUDE.md
